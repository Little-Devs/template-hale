---
import { site } from '../data/site';
const { projects } = site;
---
<section class="wrap section" id="projects">
  <div class="section-head"><p class="kicker">{projects.kicker}</p><h2>{projects.title}</h2></div>
  <div class="work-grid">
    {projects.items.map((item) => (
      <article class="work-card">
        <div class={`work-media ${item.tone}`}></div>
        <div class="work-body"><p class="tag">{item.tag}</p><h3>{item.title}</h3><p>{item.note}</p></div>
      </article>
    ))}
  </div>
</section>
