---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Practice from '../components/Practice.astro';
import Projects from '../components/Projects.astro';
import Approach from '../components/Approach.astro';
import Studio from '../components/Studio.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
---
<BaseLayout>
  <Header />
  <main id="main">
    {site.sections.hero && <Hero />}
    {site.sections.practice && <Practice />}
    {site.sections.projects && <Projects />}
    {site.sections.approach && <Approach />}
    {site.sections.studio && <Studio />}
    {site.sections.contact && <Contact />}
  </main>
  <Footer />
</BaseLayout>
